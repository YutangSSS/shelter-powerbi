table dim_date
	dataCategory: Time

	column date
		dataType: dateTime
		formatString: yyyy-mm-dd
		isKey
		sourceColumn: date

	column month_start
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: month_start

	column month_label
		dataType: string
		sourceColumn: month_label

	column fy_start_year
		dataType: int64
		summarizeBy: none
		sourceColumn: fy_start_year

	column fiscal_year
		dataType: string
		sourceColumn: fiscal_year

	column fiscal_quarter
		dataType: string
		sourceColumn: fiscal_quarter

	column fiscal_month_number
		dataType: int64
		summarizeBy: none
		sourceColumn: fiscal_month_number

	column is_complete_month
		dataType: boolean
		sourceColumn: is_complete_month

	partition dim_date = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"month_start", type date}, {"month_label", type text}, {"fy_start_year", Int64.Type}, {"fiscal_year", type text}, {"fiscal_quarter", type text}, {"fiscal_month_number", Int64.Type}, {"is_complete_month", type logical}})
				in
				    Typed
