table dim_animal_type

	column animal_type
		dataType: string
		isKey
		sourceColumn: animal_type

	partition dim_animal_type = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\dim_animal_type.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"animal_type", type text}})
				in
				    Typed
