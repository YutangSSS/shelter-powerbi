table fct_stays

	column stay_id
		dataType: int64
		isKey
		summarizeBy: none
		sourceColumn: stay_id

	column animal_id
		dataType: string
		sourceColumn: animal_id

	column intake_seq
		dataType: int64
		summarizeBy: none
		sourceColumn: intake_seq

	column is_repeat_intake
		dataType: boolean
		sourceColumn: is_repeat_intake

	column intake_dt
		dataType: dateTime
		isHidden
		sourceColumn: intake_dt

	column intake_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: intake_date

	column outcome_dt
		dataType: dateTime
		isHidden
		sourceColumn: outcome_dt

	column outcome_date
		dataType: dateTime
		formatString: yyyy-mm-dd
		sourceColumn: outcome_date

	column intake_type
		dataType: string
		isHidden
		sourceColumn: intake_type

	column intake_condition
		dataType: string
		sourceColumn: intake_condition

	column animal_type
		dataType: string
		isHidden
		sourceColumn: animal_type

	column region_type
		dataType: string
		isHidden
		sourceColumn: region_type

	column custody_group
		dataType: string
		isHidden
		sourceColumn: custody_group

	column outcome_type
		dataType: string
		sourceColumn: outcome_type

	column deceased
		dataType: boolean
		sourceColumn: deceased

	column days_in_care
		dataType: int64
		summarizeBy: none
		sourceColumn: days_in_care

	partition fct_stays = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "\fct_stays.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"stay_id", Int64.Type}, {"animal_id", type text}, {"intake_seq", Int64.Type}, {"is_repeat_intake", type logical}, {"intake_dt", type datetime}, {"intake_date", type date}, {"outcome_dt", type datetime}, {"outcome_date", type date}, {"intake_type", type text}, {"intake_condition", type text}, {"animal_type", type text}, {"region_type", type text}, {"custody_group", type text}, {"outcome_type", type text}, {"deceased", type logical}, {"days_in_care", Int64.Type}})
				in
				    Typed
